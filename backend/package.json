{
  "name": "secure-task-manager-api",
  "version": "1.0.0",
  "description": "Secure Task Manager REST API (Express, PostgreSQL, Prisma)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:db": "node scripts/prepare-test-db.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "user:promote": "node scripts/promote-admin.js",
    "audit:purge": "node scripts/purge-audit.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testTimeout": 20000
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
