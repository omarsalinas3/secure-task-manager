NODE_ENV=development
PORT=3000
# Host port Docker publishes PostgreSQL on (use 5433 if a local PostgreSQL already uses 5432).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://app_user:local_dev_only_change_me@localhost:5432/task_manager
JWT_ACCESS_SECRET=replace_with_long_random_value
JWT_REFRESH_SECRET=replace_with_another_long_random_value
CORS_ORIGINS=http://localhost:3000
# Push provider: "log" (development, redacted) or "none".
PUSH_PROVIDER=log
# Days to keep audit events before scripts/purge-audit.js deletes them.
AUDIT_RETENTION_DAYS=90
